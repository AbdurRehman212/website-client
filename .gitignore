# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local caches and temporary captures
.cache/
.turbo/
.eslintcache
/logs/
/screenshots/
screenshot-*.png
screenshot-*.jpg
screenshot-*.jpeg

# local credentials and secrets
/credentials/
credentials.*
*.key
*.p12
*.pfx

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code tooling (local skill cache, not project source)
/.agents/
/.claude/

# raw client-supplied source material (docx, duplicate logo exports) —
# already integrated into src/content/site.ts and public/brand/
/project data/
